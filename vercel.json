{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/b/:bid/:token", "destination": "/batch.html?bid=:bid&token=:token" },
    { "source": "/d/:rid/:token", "destination": "/doc.html?rid=:rid&token=:token" }
  ]
}
