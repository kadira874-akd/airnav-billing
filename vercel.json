{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/b/:bid/:token", "destination": "/batch.html" },
    { "source": "/d/:rid/:token", "destination": "/doc.html" },
    { "source": "/a/:token/:email", "destination": "/auth.html" }
  ],
  "routes": [
    { "src": "/batch", "headers": { "Location": "/batch.html" }, "status": { "code": 301 } },
    { "src": "/doc", "headers": { "Location": "/doc.html" }, "status": { "code": 301 } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
